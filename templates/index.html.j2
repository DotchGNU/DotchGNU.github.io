<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.name }}</title>
<meta name="description" content="{{ site.name }} — RNA modification, CRISPR specificity, and datasets built for machine learning.">
<meta name="author" content="{{ site.name }}">
<link rel="stylesheet" href="style.css?v={{ css_v }}">
</head>
<body>
<main>

  {# .contact groups the two right-hand lines so their spacing is set by one
     value rather than by the height of the name. See .masthead in style.css. #}
  <header class="masthead">
    <h1>{{ site.name }}</h1>
    <div class="contact">
      {% if site.emails %}
      <p class="emails">Email : {{ site.emails | join(' / ') }}</p>
      {% endif %}
      <nav class="links" aria-label="Profiles">
        {% for link in site.links %}
        <a href="{{ link.url }}"{% if link.url.startswith('http') %} rel="me noopener"{% endif %}>{{ link.label }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  {% if bio %}
  <div class="bio">
    {% for para in bio %}
    <p>{{ para }}</p>
    {% endfor %}
  </div>
  {% endif %}

  {% if first or co %}
  <section>
    <h2>Publications</h2>
    {% if first %}
    <h3>First-author</h3>
    <ul class="entries">
      {% for p in first %}
      <li>
        <p class="title">{{ p.title }}</p>
        <p class="authors">{{ p.authors_html }}</p>
        <p class="venue">
          <em>{{ p.venue }}</em>{% if p.detail %} {{ p.detail }}{% endif %} ({{ p.year }})
          {% if p.doi %}<a class="tag" href="https://doi.org/{{ p.doi }}">doi</a>
          {% elif p.status == 'in-press' %}<span class="tag tag--quiet">in press</span>
          {% endif %}
        </p>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if co %}
    <h3>Co-authored</h3>
    <ul class="entries">
      {% for p in co %}
      <li>
        <p class="title">{{ p.title }}</p>
        <p class="authors">{{ p.authors_html }}</p>
        <p class="venue">
          <em>{{ p.venue }}</em>{% if p.detail %} {{ p.detail }}{% endif %} ({{ p.year }})
          {% if p.doi %}<a class="tag" href="https://doi.org/{{ p.doi }}">doi</a>
          {% elif p.status == 'in-press' %}<span class="tag tag--quiet">in press</span>
          {% endif %}
        </p>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if site.author_notes %}
    <p class="footnote">{{ site.author_notes | join('   ·   ') }}</p>
    {% endif %}
  </section>
  {% endif %}

  {% if resources %}
  <section>
    <h2>Resources</h2>
    <ul class="entries">
      {% for r in resources %}
      <li>
        <p class="title">{{ r.name }}</p>
        <p class="venue">
          {{ r.blurb }}
          {% for l in r.links %}<a class="tag" href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
        </p>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if awards %}
  <section>
    <h2>Honors and Awards</h2>
    <ul class="awards">
      {% for a in awards %}
      <li>
        <span class="award-body">
          {% if a.url %}<a href="{{ a.url }}">{{ a.title }}</a>{% else %}{{ a.title }}{% endif %}
          {% if a.detail %}<span class="award-detail">{{ a.detail }}</span>{% endif %}
        </span>
        <time>{{ a.year }}</time>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if talks %}
  <section>
    <details>
      <summary>Presentations ({{ talks|length }})</summary>
      <ul class="entries entries--tight">
        {% for t in talks %}
        <li>
          <p class="title">{{ t.title }}</p>
          <p class="authors">{{ t.authors_html }}</p>
          <p class="venue">
            {{ t.venue }} ({{ t.year }})
            <span class="tag tag--quiet">{{ t.kind }}</span>
            {% if t.note %}<span class="tag">{{ t.note }}</span>{% endif %}
          </p>
        </li>
        {% endfor %}
      </ul>
    </details>
  </section>
  {% endif %}

  {% if education %}
  <section>
    <h2>Education</h2>
    <ul class="edu">
      {% for e in education %}
      {# Two grid children, never three: the degree and the school are one
         block on the left, the period sits on the right. A third child here
         would be pushed onto its own row, which is what used to happen. #}
      <li>
        <span class="edu-body">
          <span class="edu-degree"><strong>{{ e.degree }}</strong>{% if e.field %}, {{ e.field }}{% endif %}</span>
          <span class="edu-line">
            {%- if e.dept_url %}<a href="{{ e.dept_url }}">{% endif -%}
            {% if e.dept %}{{ e.dept }}, {% endif %}{{ e.school }}
            {%- if e.dept_url %}</a>{% endif -%}
          </span>
          {% if e.advisor %}<span class="edu-line">Advisor: {{ e.advisor }}</span>{% endif %}
          {% if e.note %}<span class="edu-line">{{ e.note }}</span>{% endif %}
        </span>
        <time>{{ e.period }}</time>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <footer>
    Last updated {{ site.updated }}
  </footer>

</main>
</body>
</html>
